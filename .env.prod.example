# PostgreSQL — separate production Compose project/volume; no public DB port.
# Compose fixes host/port/SSL to the internal PostgreSQL service.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=parlons_violence_prod
DB_USER=parlons_violence_prod
DB_PASSWORD=replace_with_random_production_password
DB_SSL=false
DB_SCHEMA=public

# Better Auth — generate a stable random secret of at least 32 characters.
BETTER_AUTH_SECRET=replace_with_random_secret_at_least_32_characters
BETTER_AUTH_URL=https://parlonsviolence.ch

# Same HTTPS origin for app, invitation POST validation, auth and client.
APP_URL=https://parlonsviolence.ch
VITE_APP_NAME=Parlons Violence
VITE_APP_URL=https://parlonsviolence.ch
VITE_BETTER_AUTH_URL=https://parlonsviolence.ch
# VITE_* values are build arguments: rebuild after changing them. No secrets here.
VITE_ENABLE_OAUTH=false
# Optional server credentials: both fields required per enabled provider.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — sending-only production key and verified sender domain.
# SMTP_* / DOMAIN_NAME / POSTGRES_* are obsolete application configuration.
RESEND_API_KEY=re_replace_with_production_key
EMAIL_FROM=noreply@parlonsviolence.ch
EMAIL_REPLY_TO=contact@parlonsviolence.ch

# Arcjet — production site key (development keys run in DRY_RUN).
ARCJET_KEY=ajkey_replace_with_production_site_key
SERVICE_NAME=parlons-violence-prod
LOG_LEVEL=info

# Public access requires exactly false. Missing/invalid values keep invitations.
# This does not enable contributions or bypass auth, CSRF, Arcjet or moderation.
BETA_ACCESS_REQUIRED=false
# Only used when BETA_ACCESS_REQUIRED=true: comma-separated random 32–128
# character codes using A–Z, a–z, 0–9, _ and -. Empty codes never open access.
BETA_INVITATION_CODES=
# Contributions remain closed independently until moderation is ready.
BETA_SUBMISSIONS_OPEN=false
BETA_MODERATION_SCHEDULE=Créneaux à confirmer avant ouverture des contributions.

# Presentation only. Default/invalid: test (fictitious scenarios).
# real: real testimony copy; does not open submissions or bypass moderation.
# See docs/publication-mode-readiness.md before enabling real in production.
PUBLICATION_MODE=test
