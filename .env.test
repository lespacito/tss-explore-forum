# Test Environment Variables
# Mock values for running tests without real credentials

# Database (in-memory SQLite for tests)
DATABASE_URL="file::memory:?cache=shared"
DB_HOST="localhost"
DB_NAME="test_db"
DB_USER="test_user"
DB_PASSWORD="test_password"

# Better Auth
BETTER_AUTH_SECRET="test-secret-key-minimum-32-characters-long-for-testing"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth (mock credentials for tests)
GITHUB_CLIENT_ID="test-github-client-id"
GITHUB_CLIENT_SECRET="test-github-client-secret"
GOOGLE_CLIENT_ID="test-google-client-id"
GOOGLE_CLIENT_SECRET="test-google-client-secret"

# Email (mock for tests)
RESEND_API_KEY="test-resend-api-key"
EMAIL_FROM="test@example.com"

# Arcjet (mock for tests)
ARCJET_KEY="test-arcjet-key"

# Environment
NODE_ENV="test"
LOG_LEVEL="error"
