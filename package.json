{
  "name": "parlons-violence",
  "private": true,
  "packageManager": "bun@1.3.10",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --host 127.0.0.1 --port 3001",
    "dev:local": "dotenv -e .env.local -- bun --bun vite dev --host 127.0.0.1 --port 3001",
    "build": "bun --bun vite build",
    "serve": "bun --bun vite preview",
    "start": "bun .output/server/index.mjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:migrate": "dotenv -e .env.test -- drizzle-kit migrate",
    "test:e2e:seed": "dotenv -e .env.test -- tsx src/db/seed-e2e.ts",
    "format": "biome check --write",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "drizzle-kit generate",
    "db:local:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:local:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:local:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
