# Environment
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tss_explore_forum
DB_USER=tss_local
DB_PASSWORD=tss_local_password
DB_SSL=false

# Local database tooling
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_for_local_use

# Auth
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=your_secret_key_min_32_chars_here

# OAuth GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Emails - Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@parlonsviolence.ch
EMAIL_REPLY_TO=contact@parlonsviolence.ch

# Application
APP_URL=http://127.0.0.1:3001

# Client
VITE_APP_NAME=Parlons Violence
VITE_APP_URL=http://127.0.0.1:3001
VITE_BETTER_AUTH_URL=http://127.0.0.1:3001

# Arcjet (Rate Limiting & Security)
ARCJET_KEY=your_arcjet_key

# Logging (optional)
LOG_LEVEL=info
LOG_DIR=logs
SERVICE_NAME=parlons-violence
