# PostgreSQL — private Docker network only
DB_HOST=postgres
DB_PORT=5432
DB_NAME=parlons_violence_staging
DB_USER=parlons_violence_staging
DB_PASSWORD=replace_with_random_password
DB_SSL=false
DB_SCHEMA=public

# Better Auth
BETTER_AUTH_URL=https://staging.parlonsviolence.ch
BETTER_AUTH_SECRET=replace_me

# OAuth — disabled for the private beta staging environment
VITE_ENABLE_OAUTH=false

# Resend — use a sending-only key dedicated to staging
RESEND_API_KEY=re_replace_with_staging_key
EMAIL_FROM=staging@parlonsviolence.ch
EMAIL_REPLY_TO=contact@parlonsviolence.ch

# Arcjet — use a site/key dedicated to staging
ARCJET_KEY=ajkey_replace_with_staging_site_key

# Application
APP_URL=https://staging.parlonsviolence.ch
VITE_APP_NAME=Parlons Violence — Staging
VITE_APP_URL=https://staging.parlonsviolence.ch
VITE_BETTER_AUTH_URL=https://staging.parlonsviolence.ch
SERVICE_NAME=parlons-violence-staging
LOG_LEVEL=info

# Private beta — keep submissions closed for the first deployment
BETA_INVITATION_CODES=replace_me
BETA_SUBMISSIONS_OPEN=false
BETA_MODERATION_SCHEDULE=Staging uniquement — aucun créneau de modération public.
